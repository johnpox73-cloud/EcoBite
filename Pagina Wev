<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoBite - Rescata Comida, Salva el Planeta</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            dark: '#0f172a'
                        },
                        amberAccent: '#f59e0b'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Poppins', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen">

    
    <!-- PASO 3.1 & 3.3: HEADER SEMÁNTICO Y RESPONSIVE -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                
                <!-- Brand Logo -->
                <a href="#" class="flex items-center gap-2.5 group">
                    <div class="w-10 h-10 rounded-xl bg-brand-500 text-white flex items-center justify-center font-heading text-xl font-bold shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-leaf"></i>
                    </div>
                    <div>
                        <span class="font-heading font-extrabold text-2xl text-slate-900 tracking-tight">Eco<span class="text-brand-500">Bite</span></span>
                        <span class="block text-[10px] text-slate-500 font-semibold uppercase tracking-wider -mt-1">Salva Comida</span>
                    </div>
                </a>
                <!-- Menú de Navegación Desktop (PASO 3.3 Breakpoint >768px) -->
                <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-600">
                    <a href="#explorar" class="hover:text-brand-600 transition">Explorar EcoBoxes</a>
                    <a href="#impacto" class="hover:text-brand-600 transition">Mi Impacto</a>
                    <a href="#nosotros" class="hover:text-brand-600 transition">¿Cómo Funciona?</a>
                </nav>

                <!-- Acciones de Usuario -->
                <div class="flex items-center gap-3">
                    <button id="cartBtn" class="relative p-2.5 text-slate-700 hover:text-brand-600 hover:bg-brand-50 rounded-xl transition" title="Ver carrito de reservas">
                        <i class="fa-solid fa-basket-shopping text-xl"></i>
                        <span id="cartBadge" class="hidden absolute top-1 right-1 bg-amber-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">1</span>
                    </button>

                    <button class="hidden sm:inline-flex bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm px-4 py-2.5 rounded-xl shadow-md shadow-brand-500/20 transition hover:-translate-y-0.5">
                        <i class="fa-solid fa-store mr-2"></i> Unir mi local
                    </button>

                    <!-- Botón Menú Hamburguesa Móvil -->
                    <button id="mobileMenuBtn" class="md:hidden p-2 text-slate-700 hover:text-brand-600 rounded-lg focus:outline-none" aria-label="Abrir menú">
                        <i class="fa-solid fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menú Desplegable Móvil (<768px) -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
            <div class="flex items-center gap-2 py-2 px-3 bg-slate-100 rounded-lg text-xs font-medium text-slate-700">
                <i class="fa-solid fa-location-dot text-brand-500"></i>
                <span>Quito, Centro Histórico</span>
            </div>
            <a href="#explorar" class="block py-2 text-slate-700 font-medium hover:text-brand-600">Explorar EcoBoxes</a>
            <a href="#impacto" class="block py-2 text-slate-700 font-medium hover:text-brand-600">Mi Impacto Ambiental</a>
            <a href="#nosotros" class="block py-2 text-slate-700 font-medium hover:text-brand-600">¿Cómo Funciona?</a>
            <button class="w-full mt-2 bg-brand-500 text-white font-semibold text-sm py-2.5 rounded-xl shadow-sm">
                <i class="fa-solid fa-store mr-2"></i> Unir mi local
            </button>
        </div>
    </header>

    <main class="flex-grow">
        <!-- SECCIÓN HERO COMPACTA & ATRACTIVA -->
        <section class="bg-gradient-to-b from-brand-50/60 to-slate-50 py-10 lg:py-16 border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100 text-brand-700 font-semibold text-xs mb-4">
                    <i class="fa-solid fa-bolt text-amber-500"></i> ¡Ofertas de comida fresca de hoy hasta un 70% OFF!
                </span>
                <h1 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl text-slate-900 tracking-tight max-w-4xl mx-auto leading-tight">
                    Disfruta comida deliciosa y <span class="text-brand-500 underline decoration-brand-500/30 decoration-wavy">reduce el desperdicio</span>
                </h1>
                <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
                    Rescata las "EcoBoxes" con productos excedentes de tus panaderías, restaurantes y supermercados favoritos a precios imbatibles.
                </p>

                <!-- Buscador rápido -->
                <div class="mt-8 max-w-2xl mx-auto bg-white p-2 rounded-2xl shadow-lg border border-slate-200/80 flex flex-col sm:flex-row items-center gap-2">
                    <div class="flex items-center gap-3 px-3 py-2 w-full">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                        <input type="text" id="searchInput" placeholder="Buscar local, comida o categoría..." class="w-full text-sm text-slate-800 bg-transparent focus:outline-none">
                    </div>
                    <button class="w-full sm:w-auto bg-brand-500 hover:bg-brand-600 text-white font-medium text-sm px-6 py-3 rounded-xl transition flex items-center justify-center gap-2 shrink-0">
                        <i class="fa-solid fa-filter"></i> Buscar
                    </button>
                </div>
            </div>
        </section>

        <!-- PASO 3.5: FILTRADO DINÁMICO DE CATEGORÍAS -->
        <section id="explorar" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 class="font-heading text-2xl sm:text-3xl font-bold text-slate-900">EcoBoxes Disponibles Cerca de Ti</h2>
                    <p class="text-slate-500 text-sm mt-1">Límite de recogida hoy • Stock en tiempo real</p>
                </div>

                <!-- Botones de filtro de categorías (JS Interactive) -->
                <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
                    <button class="filter-btn active bg-brand-500 text-white px-4 py-2 rounded-xl text-xs sm:text-sm font-medium whitespace-nowrap transition" data-category="all">
                        <i class="fa-solid fa-border-all mr-1.5"></i> Todas
                    </button>
                    <button class="filter-btn bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium whitespace-nowrap transition" data-category="panaderia">
                        <i class="fa-solid fa-bread-slice mr-1.5 text-amber-600"></i> Panaderías
                    </button>
                    <button class="filter-btn bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium whitespace-nowrap transition" data-category="vegano">
                        <i class="fa-solid fa-seedling mr-1.5 text-emerald-600"></i> Vegano
                    </button>
                    <button class="filter-btn bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium whitespace-nowrap transition" data-category="restaurante">
                        <i class="fa-solid fa-utensils mr-1.5 text-rose-500"></i> Restaurantes
                    </button>
                </div>
            </div>

